{% extends 'base.html.twig' %}
{% block title %}Blog{% endblock %}


{% block body %}
<div id="blog" class="container">
    <header class="page-header-block">
        <span class="eyebrow">Journal</span>
        {% if searchTerm is defined and searchTerm %}
            <h1>Results for “{{ searchTerm }}”</h1>
        {% else %}
            <h1>Blog</h1>
        {% endif %}
    </header>

    <div class="row">
        <!-- Posts -->
        <div class="col-xs-12 col-md-8">
            <div id="post-list">
                {% if total > 0 %}
                    <div class="results-bar glass" role="status">
                        <span class="results-count">
                            <i class="fa fa-file-text-o"></i>
                            Mostrando <strong>{{ posts.iterator|length }}</strong> de <strong>{{ total }}</strong> {{ total == 1 ? 'post' : 'posts' }}
                        </span>
                        <span class="results-page">Página {{ page }} <span class="results-sep">/</span> {{ totalPages }}</span>
                        <span class="results-progress" aria-hidden="true">
                            <span style="--value: {{ (page / totalPages * 100)|round }}%"></span>
                        </span>
                    </div></br>

                    {% for post in posts %}
                        {{ include('partials/_post.html.twig', {'post': post}) }}
                    {% endfor %}

                    {% if searchTerm is defined %}
                        {{ include('partials/_paginador.html.twig', {
                            'page': page,
                            'totalPages': totalPages,
                            'ruta': 'blog_buscar',
                            'parametros': {'searchTerm': searchTerm}
                        }) }}
                    {% else %}
                        {{ include('partials/_paginador.html.twig', {
                            'page': page,
                            'totalPages': totalPages,
                            'ruta': 'blog'
                        }) }}
                    {% endif %}
                {% else %}
                    <div class="card empty-state">
                        <i class="fa fa-search"></i>
                        No posts found.
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Sidebar -->
        <aside class="col-xs-12 col-md-4 sidebar">
            <form class="" action='{{ path('blog_buscar') }}'>
              <input type="text" class="form-control" style="display:unset; width:85%" placeholder="Research" name='searchTerm'>
              <button type='submit' class="btn btn-primary btn-danger"><i class="fa fa-search"></i>
              </button>
            </form>

            <div class="card card-sm" data-reveal>
                <h4>Categories</h4>
                <ul class="link-list">
                    <li><a href="#">Category I</a></li>
                    <li><a href="#">Category II</a></li>
                    <li><a href="#">Category III</a></li>
                    <li><a href="#">Category IV</a></li>
                    <li><a href="#">Category V</a></li>
                </ul>
            </div>

            <div class="card card-sm glass" data-reveal>
                <h4>Soluta</h4>
                <p class="text-muted" style="margin:0">Quod soluta corrupti earum officia vel inventore vitae quidem, consequuntur odit impedit.</p>
            </div>

            <div class="card card-sm" data-reveal>
                <h4>Recent posts</h4>
                {% if recents is defined and recents|length > 0 %}
                    {% for recent in recents %}
                        {{ include('partials/_recent_post.html.twig', {recent: recent}) }}
                    {% endfor %}
                {% else %}
                    <p class="text-muted" style="margin:0">No recent posts yet.</p>
                {% endif %}
            </div>
        </aside> 
    </div>
</div>
{% endblock %}

