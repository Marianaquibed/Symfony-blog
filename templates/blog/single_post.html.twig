{% extends 'base.html.twig' %}
{% block title %}{{ post.title }}{% endblock %}
{% block body %}

    <div id="single">
    <div class="container">

    <!-- Full Article -->
      <div class="row">
      <h2>{{ post.title }}</h2>
      <hr class="subtitle">
      <div class="block1">
      <div class="col-xs-12 col-sm-9">
        <img src="{{ asset('images/index/gallery/' ~ post.image) }}" alt="{{ post.title }}" class="img-responsive margin-bottom-20">
        {{ post.content }}
        <h4>By {{ post.postUser.name }}</h4>
        <hr>
        <ul class="list-inline">
            <li>{{ post.publishedAt|date('d') }} {{ post.publishedAt|date('F') }} |</li>
            <li><a class="page-scroll" href="#form">COMMENT</a> <i class="fa fa-comments sr-icons"></i> {{post.numComments}} |</li>
            <script type='text/javascript'>
                document.addEventListener('DOMContentLoaded', function() {
                    const likeLink = document.querySelector('a[href="{{ path('post_like', {slug: post.slug}) }}"]');
                    // Hay que coger el id 'likes' para poder cambiar luego el valor al número de likes actual
                    const likesSpan = document.querySelector('#likes');
                    likeLink.addEventListener('click', function(event) {
                        event.preventDefault();
                        fetch(likeLink.href, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/json'
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                likesSpan.innerHTML = " " + data.likes;
                            }
                        })
                        .catch(error => console.error('Error:', error));
                    });
                });
            </script>
            <li><a href="{{ path('post_like', {slug: post.slug}) }}">LIKE</a> <i class="fa fa-heart sr-icons"></i> {{post.numLikes}}</li>
        </ul>
        </div>
        <div class="col-xs-12 col-sm-3">
            <h4>Recent Posts</h4>
            <hr class="subtitle1">

            {% for recent in recents %}
            <div class="new {% if loop.first %}new1{% endif %}">
                {{ include('partials/_recent_post.html.twig', {'recent': recent}) }}
            </div>
            {% endfor %}
            </div>
        </div>
    </div>
    </div>
    <!-- End of Full Article -->

    <!-- Comments -->
    <div class="row">
        <div class="col-xs-12 col-sm-12 block2">
            
            {% for comment in post.comments %}
                {{ include('partials/_post_comments.html.twig', {'comment': comment}) }}
            {% endfor %}

            <hr class="line">
            
            <div id="form" class="col-xs-12 col-sm-6 col-sm-push-3">
                {{ form(commentForm, {'attr': {'class': 'form-horizontal'}}) }}
            </div>
            
        </div>
    </div>
<!-- End of Comments -->  
     </div>
    </div>

{% endblock %}