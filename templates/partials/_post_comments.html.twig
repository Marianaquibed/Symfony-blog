<div class="comment {% if loop.index0 is odd %}alt-comment{% endif %}">
    <h4>{{ comment.name }}</h4>
    
    <span>
        <i class="fa fa-star sr-icons"></i>
        <i class="fa fa-star sr-icons"></i>
        <i class="fa fa-star sr-icons"></i>
        <i class="fa fa-star sr-icons"></i>
        <i class="fa fa-star sr-icons"></i>
    </span>
    
    <p class="time">{{ comment.publishedAt|date('h:i A') }}</p>
    <hr>
    
    <p>{{ comment.text }}</p>
</div>