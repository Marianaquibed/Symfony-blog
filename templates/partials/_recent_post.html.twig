<div class="post">
  <div class="post-heading">
    <span class="date">{{ recent.publishedAt | date('d M') | upper }}</span>
    <img class="img-responsive" src="{{ asset('images/index/gallery/' ~ (recent.image ?? 'wedding.jpg')) }}" alt="post's picture">
  </div>
  <div class="post-body">
    <span>
      <i class="fa fa-heart sr-icons"></i> 10
      <i class="fa fa-comments sr-icons"></i> 10
    </span>
    <h4 class="text-left">
      <a href="{{ path('single_post', {'slug': recent.slug}) }}">
        <strong>{{ recent.title }}</strong>
      </a>
    </h4>
    <h5>By <span>{{ recent.postUser.name }}</span></h5>
  </div>
</div>